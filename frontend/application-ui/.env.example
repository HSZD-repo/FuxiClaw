# Application UI environment variables.
# Copy to .env (git-ignored) and tweak as needed.

# HTTP/WS target for the Vite dev proxy.
# The backend (`python -m openharness.web` or `oh web`) listens on 127.0.0.1:8765 by default.
VITE_OH_BACKEND_URL=http://127.0.0.1:8765

# Optional: hard-code the WebSocket URL the browser uses.
# When unset, the client builds ws://<current-origin>/ws and relies on the proxy above.
# Useful for previewing a production build served from a different host.
# VITE_OH_WS_URL=ws://127.0.0.1:8765/ws
