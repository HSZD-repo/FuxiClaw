# OpenHarness — environment variables for the Web UI backend.
#
# How to use:
#   cp .env.example .env
#   # edit .env, fill in your key
#   scripts/dev_application_ui.sh
#
# The dev script auto-sources .env at repo root (git-ignored), so you don't
# need to `export` anything in your shell. Values here are also picked up by
# the `oh` CLI when it runs in the same shell.

# ---- required ----

# API key for the upstream LLM provider.
OPENAI_API_KEY=

# ---- provider / model ----

# OpenAI-compatible base URL. Leave empty for OpenAI itself; set for Kimi,
# DeepSeek, GLM, Ollama, etc.
#   Kimi / Moonshot:   https://api.moonshot.cn/v1
#   DeepSeek:          https://api.deepseek.com/v1
#   GLM / Zhipu:       https://open.bigmodel.cn/api/paas/v4
#   Ollama (local):    http://localhost:11434/v1
OPENAI_BASE_URL=

# Model name. Defaults to moonshot-v1-8k if unset.
OPENHARNESS_MODEL=

# ---- optional ----

# Free-form label shown in the Application UI header.
# OPENHARNESS_PROVIDER=Moonshot (Kimi)

# Override the system prompt used by the minimal Web UI backend.
# OPENHARNESS_SYSTEM_PROMPT=

# Log level for the backend (DEBUG / INFO / WARNING / ERROR).
# OPENHARNESS_LOG_LEVEL=INFO
